# Decision backend — Laya (open weights via Laya Studio, Jev-compatible API).
# Local venv on 127.0.0.1:8000 by default (deps/setup.ps1); hosted Laya Studio
# (api.laya.studio) also works with an lsk_live_... key.
DECISION_BACKEND=laya
LAYA_API_KEY=
LAYA_BASE_URL=http://127.0.0.1:8000
# Jev fallback (only if DECISION_BACKEND=jev): Typesafe waitlist, Vercel Gateway, or OpenRouter
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0

# Single gateway: OpenCode Go ($10/mo) — GLM / DeepSeek / Kimi / Qwen.
GATEWAY_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=

# ── DeepSeek DIRECT API (docs/DEEPSEEK_DIRECT.md) ────────────────────────────
# OpenCode Go's WEEKLY window is the quota that keeps running out. Outside DeepSeek's
# peak hours the router and the fleet use DeepSeek's OWN API (half price, own credit),
# so Go's quota is left for Kimi/GLM/Qwen. Peak = 06:30-09:30 and 11:30-15:30 IST,
# Mon-Fri; everything else (incl. all weekend) is off-peak. Inert without a key.
# Top up at platform.deepseek.com, then create a key there and paste it below.
DEEPSEEK_DIRECT=1
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_DIRECT_MODEL=deepseek-flash      # fixed: every direct DeepSeek call uses flash (CEO order 2026-10-02)
# DEEPSEEK_PROVIDER=deepseek                # jcode provider id for fleet terminals
# DEEPSEEK_DIRECT_ALL_HOURS=1               # also use direct at peak (2x, saves Go quota)
#   CEO order 2026-10-01 18:30 (docs/ORDER_2026-10-01_deepseek-only.md): "run on the DeepSeek
#   API key instead of OpenCode Go, for now", because the Go WEEKLY window is nearly spent. The
#   live .env sets this to 1 while that order stands; the code default (unset = 0) is off-peak
#   only, which is the documented behaviour in docs/DEEPSEEK_DIRECT.md.

# Claude subscription-only: DO NOT set ANTHROPIC_API_KEY.
# Instead: npm i -g @anthropic-ai/claude-code; claude login
# The brain (manager / opposer) runs the official Claude Code CLI (`claude -p`) on
# the same Pro subscription, with Read/Glob/Grep scoped to the project.
# CLAUDE_BACKEND=oauth restores the old raw OAuth call.
CLAUDE_SONNET=claude-sonnet-5-5
CLAUDE_OPUS=claude-opus-5-5
CLAUDE_FALLBACK_MODEL=space-bunny-free
# CLAUDE_BACKEND=cli      # cli (default) = `claude -p`; oauth = raw OAuth call
# CLAUDE_BIN=             # override path to the Claude Code binary (defaults to the npm global install)
# CLAUDE_CLI_TIMEOUT_SECONDS=300

# CEO assistant model. Defaults to CLAUDE_FALLBACK_MODEL (cheapest gateway model).
# Use "claude" for Sonnet, or a full id such as claude-opus-5-5 to run the
# assistant through Claude Code with read access to the projects.
# ASSISTANT_MODEL=claude-opus-5-5

# Slack mirror (optional). Socket Mode (xapp-... + connections:write) is primary;
# without SLACK_APP_TOKEN the bridge polls conversations.history with the bot token.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0XXXXXXX
# SLACK_APP_TOKEN=xapp-...
# SLACK_BRIDGE=1          # 0 disables the bridge entirely
# SLACK_SOCKET_MODE=1     # force Socket Mode; 0 forces the polling fallback
# SLACK_BRIDGE_INTERVAL_MS=4000

# Pipeline tuning.
# GATE_WAIT_SECONDS=600       # how long a pipeline waits at a gate before parking (resumable later)
# PIPELINE_MAX_LOOPS=1        # max manager review LOOP rounds before merging anyway
# Laya gates below are calibrated in docs/LAYA_TUNING.md on 70 labelled decisions
# (repeat 2, live local Laya). Laya's `confidence` is 1 - H(p)/log k and reads low
# for multi-option questions, so these bars are deliberately small numbers.
# Team pick: measured 100% right at 0.20 (18/30 picks kept) and 100% at 0.30
# (4/30). 0.20 is the recommendation: same precision, more coverage.
# Measured (2026-10-01, ops/laya-eval.ts): >=0.20 keeps 18/30 picks at 100%
# precision, vs 4/30 at 0.30 - so 0.20 is the value set here.
# NOTE: src/company/assistant.ts still hard-codes `?? 0.3` as the fallback, so the
# code default stays 0.3 until this env value is actually loaded by that process.
LAYA_TEAM_MIN_CONF=0.20
# Track pick: measured 100% right at 0.20, but only 4/26 picks clear it, so the
# assistant's own planned track stands almost always. Safe, and unchanged.
# LAYA_TRACK_MIN_CONF=0.2
# Manager brain pick (runManagers): classifyBrain now returns the probability of
# its "hard brain" question, and picks OPUS only at >= 0.50 (measured 83% right).
# RUN_MANAGER_LAYA_MIN_CONF=0.5

PORT=8787

# ── Trust boundary (docs/CEO_RUNBOOK.md §0) ─────────────────────────────────
# Shared secret for the company control plane. Required as the X-Company-Token
# header on every /company/* mutation (agent messages, pipeline runs, budgets,
# project creation) and on GET /company/stream. Generate one with:
#   powershell -NoProfile -Command "-join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })"
# and restart the router. The dashboard fetches it automatically over loopback.
COMPANY_AUTH_TOKEN=
# Bind address. 127.0.0.1 = loopback only (default, safest).
# 0.0.0.0 exposes the control plane on the LAN and then REQUIRES a token
# (the server refuses to start off-host without one).
HOST=127.0.0.1
# Extra Host-header names allowed to fetch the secret bootstrap (optional;
# loopback names are always allowed). Comma separated.
# COMPANY_ALLOWED_HOSTS=

# ── Company memory (docs/MEMORY.md) ──────────────────────────────
# graphify (PyPI package "graphifyy", CLI "graphify") is installed ONLY into
# deps\venv. Code is indexed OFFLINE with tree-sitter AST: no key, nothing leaves
# the machine. Docs and the memory notes are markdown, so they need an LLM key:
# set the key below and the NEXT memory rebuild switches semantic extraction on,
# with no code change. Without a key everything still works (code graph plus
# keyword recall over the notes).
GRAPHIFY_API_KEY=
# Which backend that key belongs to: claude | openai | gemini | deepseek | kimi | ollama
# (default: openai, i.e. any OpenAI-compatible endpoint). The key is handed to
# graphify under the backend's own variable name (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...).
# GRAPHIFY_BACKEND=openai
# Optional for an OpenAI-compatible/self-hosted endpoint (e.g. the local gateway).
# GRAPHIFY_BASE_URL=
# GRAPHIFY_MODEL=
# Background graph rebuild debounce in seconds (default 300).
# MEMORY_REBUILD_MIN_S=300
# Set to 0 to disable the background rebuild (writes still mark the memory dirty).
# MEMORY_AUTOREBUILD=1

# ── Fleet (docs/FLEET_SPEC.md, docs/LAYA_FIX_SPEC.md) ─────────────────
# Machine-wide terminal limit. Counted from REAL processes (jcode.exe terminals plus
# `opencode run` workers; the shared jcode server and helpers are excluded, and
# %USERPROFILE%\.jcode\active_pids is NOT a terminal count - it points at the server).
MAX_PARALLEL_SESSIONS=30
# The fleet will not open a new terminal while free memory is below this (MB). 0 = off.
# CEO order 2026-10-01: free RAM reads ~0.7 GB on this box because our own workers, Laya,
# Kafka downloads and the VM hold the rest, and the floor only DELAYS work - so it is lifted
# to 256 here. The code default (2048) is unchanged; this is a per-machine value.
# The SAME key is ops/router-supervisor.ps1's $ramFloor (default 2048). That floor gates
# REPLACING an unresponsive router, never STARTING one, and since 2026-10-01 the supervisor
# also falls back to this file when the variable is unset in its process environment (the
# scheduled task has no env block, so before that a .env-only value never reached it).
MIN_FREE_RAM_MB=256
# Resume queue (src/company/pipeline.ts resumeMinFreeRamMb, code default 2048, 0 = off):
# boot does not hand a mid-stage task back to a staggered resume queue while free RAM is
# below this. Lifted to 256 by the same CEO order (it only DELAYS resumed work).
RESUME_MIN_FREE_RAM_MB=256
# Ops scripts (ops/kafka-up.ps1) skip their own free-RAM guard when this is 1. Same CEO order:
# the guard only delays the broker. It stays OFF unless a machine is deliberately oversubscribed.
# LAYA_IGNORE_RAM_GUARD=1
# Fleet's own cap; unset means "same as MAX_PARALLEL_SESSIONS".
# FLEET_MAX_SESSIONS=6
# Budget-driven parallelism cap. These have NO default: an unset knob means "no budget cap",
# so MAX_PARALLEL_SESSIONS is honoured as written. Set one only if you want OpenCode Go
# pressure to shrink the fleet (the reason is then logged once per state change).
# BUDGET_FLEET_MAX_PARALLEL_AMBER=10
# BUDGET_FLEET_MAX_PARALLEL_RED=3
# Model catalog for fleet terminals (`jcode -p <provider> -m <model>`), Laya picks one per
# work order. CEO cost rule (2026-09-29): deepseek is the DEFAULT for ALL work INCLUDING UI;
# kimi is ESCALATION ONLY (it costs far more) and needs a recorded reason - a work order that
# already failed once, or exceptionally hard multi-file coding; glm is for trivial text.
# `src/company/fleet.ts` `needsEscalation()` owns that rule and the ceiling refuses a
# confident kimi pick without one. Verify ids with `jcode model list -p opencode-go`.
# FLEET_MODEL_COMPLEX=kimi-k2.7-code
# FLEET_MODEL_STANDARD=deepseek-v4.1-flash
# FLEET_MODEL_ROUTINE=glm-5.3-flash
# FLEET_DEEPSEEK_ONLY (CEO order 2026-10-01 18:30, docs/ORDER_2026-10-01_deepseek-only.md):
# 1 = every worker/planner/reviewer pick that would spend the OpenCode Go WEEKLY quota is mapped
# onto a model DeepSeek's OWN API serves (standard/cheap work -> deepseek-v4.1-flash, i.e. direct
# id deepseek-flash; what used to be Kimi escalation -> deepseek-v4-pro). The original pick and the
# reason are kept in the trace. Inert unless the direct bank is armed (DEEPSEEK_DIRECT=1 and a
# key), so a keyless box keeps today's picks and says so. Default 0 = byte-for-byte today.
# FLEET_DEEPSEEK_ONLY=0
# Set to 0 to let Laya's pick stand even when it is not a justified escalation.
# LAYA_MODEL_CEILING=1
# F1 (2026-09-29): the pick now comes from the SHARED noul question in `dispatch.ts`
# (`chooseWorkerModel`), not from a fleet-local 3-way question, so MIN_CONF is read against
# THAT question's top probability. The calibration notes below are from the retired local
# CHOICE question; they are kept because the lesson (a gate cannot fix a rare-class pick)
# still applies.
# How long to wait for `jcode debug -S <session> set_model:<model>` - F1's only working
# per-session model switch (flags are ignored for TUI sessions, and `/model` sent through
# `jcode transcript` lands as a chat message). The socket needs a server started with
# `[display] debug_socket = true`; WITHOUT one the command prints nothing and BLOCKS
# (measured: 3 minutes), so this timeout is mandatory. A failure just means the worker
# runs the provider default - never a failed spawn. See docs/AGENT_COORDINATION.md.
# FLEET_MODEL_SWITCH_TIMEOUT_MS=20000
# Confirming the switch reads the server's own session list (`jcode debug sessions`), which
# answers in ~200-350 ms. The loop is bounded by WALL CLOCK, not by a fixed number of tries,
# so a socket that dies mid-verification cannot hold a spawn open for minutes.
# FLEET_MODEL_SWITCH_VERIFY_TIMEOUT_MS=5000
# FLEET_MODEL_SWITCH_VERIFY_MS=8000
# Confidence guard for Laya's model pick, on the TOP PROBABILITY and its LEAD over the
# runner-up (NOT on Laya's `confidence`, which is 1 - H(p)/log k and stays near zero for
# a 3-way choice even with a clear winner: p=0.403 vs 0.243 reads 0.046). Below the
# bar the rule default decides instead and the reason is recorded on the work order.
# MEASURED by LAYA-TUNE (docs/LAYA_TUNING.md, repeat 2, 17 work orders x 2): on the
# 3-way CHOICE question this gate cannot be made safe - Laya answered kimi for 14/17
# work orders and no top/lead bar both keeps coverage and stays accurate: top>=0.35
# keeps 28/34 picks at 29% right, top>=0.50 keeps 18/34 at 44%, top>=0.60 keeps 6/34
# at 67%. `confidence` never reaches 0.35 at all (max 0.22), so 0.35 means the rule
# always decides. Two better options: (a) keep the ceiling rule as the decider and
# treat Laya's pick as advisory, or (b) switch the question to the escalation form
# (two yes/no probability questions), which scored 59% overall and 78-86% right
# behind a top>=0.35..0.40 + lead>=0.08 gate.
# LAYA_MODEL_MIN_CONF=0.4
# NOT READ ANY MORE (F1): the lead and timeout belonged to the retired fleet-local question.
# LAYA_MODEL_MIN_LEAD=0.08
# LAYA_TIMEOUT_MS=90000

# ── BRAIN ROUTING (src/company/brainRouter.ts, read by the gate on every Claude call) ────
# The gate is the ONLY way to reach Claude (src/claudeSubscription.ts calls it even when a
# caller names no purpose; an unnamed purpose is treated as `generate`, which never takes
# Claude). Tier `none` runs deepseek-v4.1-flash on the Go gateway - no Claude quota is spent.
# A task is BIG when Laya's `max(long, multi)` probability and its lead over `tiny` clear:
# BUDGET_BRAIN_BIG_P=0.33
# BUDGET_BRAIN_BIG_LEAD=0.08
# Laya deadline (ms); slower than this and the purpose's fallback tier is used, which is
# `none` for every purpose - an unmeasurable task must not become a Claude task.
# MEASURED 2026-09-30 08:45 on the loaded box: `GET :8000/health` took 23.2 s while Laya was
# otherwise healthy (cuda), so the gate answered `none`/`layaDown` for every call in that window
# (Claude was reachable only via CEO naming and the hard rules). Raising this makes the gate wait
# on the request path, so it is an OPS trade-off, not a default to change blindly.
# BUDGET_BRAIN_LAYA_MS=3000
# The cheap tier's model id.
# BUDGET_BRAIN_CHEAP_MODEL=deepseek-v4.1-flash
#
# OPUS GUARDRAIL - a SHARE, not a fixed threshold (CEO rule: Claude only for big/complex
# work, and among that work Opus ~30% / Sonnet ~70%, variable). CALIBRATED by CHEAP-DEFAULT
# on 2026-09-30 with ops/brain-opus-calibration.ts: 29 realistic CEO orders, 65 Laya
# samples, 0 false positives on small/medium work, 10 fixtures the gate calls BIG. The ladder
# maps the target share to a bar, each share MEASURED against those 10 big fixtures:
#   0.60/0.08 -> 80%   0.65/0.10 -> 30%   0.75/0.20 -> 30%   0.80/0.30 -> 20%   0.84/0.40 -> 10%
# The gate takes the STRICTEST step that still reaches the target, so 0.30 -> 0.75/0.20 and
# exactly 30% (3/10) of the measured big work reaches Opus (the multi-file feature, the auth
# refactor, the frontend migration); near-ties with routine work stay on Sonnet.
# Evidence a fixed bar cannot do this: the previous 0.92/0.85 reached 0 of 10 big fixtures
# (Laya's big scores top out near 0.88), i.e. Opus would effectively never run.
# BUDGET_BRAIN_OPUS_SHARE=0.3
# Absolute overrides: when either is set it wins over the ladder (set BOTH deliberately).
# BUDGET_BRAIN_OPUS_P=0.75
# BUDGET_BRAIN_OPUS_LEAD=0.2
# CEO-named Opus/Sonnet and the hard rules (a 2nd REDO on a review, a failed/stuck plan) never
# consult these bars at all.

# ── Adaptive routing + Kafka topic (docs/LAYA_ADAPTIVE_ROUTING_SPEC.md, docs/KAFKA_BROKER_CONTRACT.md) ────
# ADAPTIVE_ROUTING: 1 = rule engine may adjust Laya's pick using live success rates, 0 = off.
ADAPTIVE_ROUTING=1
# KAFKA_BROKERS: local broker, unset = in-process topic.
KAFKA_BROKERS=127.0.0.1:9092
# Fleet DeepSeek direct readiness: JCODE_BIN = jcode probe binary, FLEET_DEEPSEEK_DIRECT_READY=1 = skip the launchability probe
JCODE_BIN=C:\Users\user\AppData\Local\jcode\bin\jcode.exe
FLEET_DEEPSEEK_DIRECT_READY=1
