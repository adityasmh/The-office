# The Office: configuration. `npx tsx ops/setup.ts` copies this to `.env`, turns MOCK_MODE on and generates a
# COMPANY_AUTH_TOKEN for you. Everything works in MOCK_MODE=1 with no keys at all. Real runs need the keys you pick below.
# Lines starting with "# NAME=" are unset by default. NEVER commit your real `.env` (it is git-ignored).

# ── Run mode ─────────────────────────────────────────────────────────────────
# 1 = no provider is called; src/mock.ts answers. Safe for a first look and for the offline checks.
# MOCK_MODE=1
PORT=8787

# ── Trust boundary (docs/CEO_RUNBOOK.md §0) ──────────────────────────────────
# Shared secret for the control plane. Required as the X-Company-Token header on every /company/* mutation and on
# GET /company/stream. `npx tsx ops/setup.ts` generates one. Make your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COMPANY_AUTH_TOKEN=
# Bind address. 127.0.0.1 = this machine only (default, safest). 0.0.0.0 = LAN, and then COMPANY_AUTH_TOKEN is REQUIRED.
HOST=127.0.0.1
# Extra Host-header names allowed to fetch the secret bootstrap (comma separated; loopback names are always allowed).
# COMPANY_ALLOWED_HOSTS=

# ── Where models come from: routing policy ───────────────────────────────────
# Which gateway, which model ids and which model families are allowed live in routing.policy.json
# (copy one of routing/*.example.json to ./routing.policy.json and edit; docs/ROUTING_POLICY.md).
# The env vars below override the file value by value.
# ROUTING_POLICY_FILE=routing.policy.json
# Gateway: any OpenAI-compatible /chat/completions endpoint. The default policy uses OpenCode Go (one key, many models).
# GATEWAY_BASE_URL=https://opencode.ai/zen/go/v1
# The key goes in the variable NAMED by gateway.keyEnv in the policy (default OPENCODE_API_KEY).
OPENCODE_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# Model ids per tier, and the allowed families (comma separated prefixes).
# ROUTINE_MODEL=glm-5.3-flash
# STANDARD_MODEL=deepseek-v4-flash
# COMPLEX_MODEL=kimi-k2.7-code
# QWEN_MODEL=qwen3.8-flash
# MODEL_ALLOWLIST=deepseek,glm

# ── Decision backend ("Laya": a small local classifier that picks teams/models) ──
# laya = local server (default http://127.0.0.1:8000, see deps/ notes in docs/LAYA_TUNING.md) or hosted with a key.
# jev  = hosted fallback. Without either, set MOCK_MODE=1 or run `DECISION_BACKEND=laya` against any server that speaks
#        the same /v1/systemone protocol.
DECISION_BACKEND=laya
LAYA_BASE_URL=http://127.0.0.1:8000
# LAYA_API_KEY=
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0
# Minimum confidence for Laya's team pick (calibrated in docs/LAYA_TUNING.md).
LAYA_TEAM_MIN_CONF=0.20
# LAYA_TRACK_MIN_CONF=0.2
# RUN_MANAGER_LAYA_MIN_CONF=0.5

# ── DeepSeek DIRECT API (optional cost saver, docs/DEEPSEEK_DIRECT.md) ───────
# 1 + a key = off-peak work goes to DeepSeek's own API at half price instead of the gateway. Peak windows come from the
# routing policy (direct.peakUtcBlocks). Inert without a key.
DEEPSEEK_DIRECT=0
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_DIRECT_MODEL=deepseek-flash
# DEEPSEEK_PROVIDER=deepseek
# DEEPSEEK_DIRECT_ALL_HOURS=1
# FLEET_DEEPSEEK_ONLY=0
# FLEET_DEEPSEEK_DIRECT_READY=1   # skip the launchability probe (jcode -p deepseek)

# ── Claude (optional "brain" for planning and review) ────────────────────────
# Uses the official Claude Code CLI on YOUR subscription: npm i -g @anthropic-ai/claude-code; claude login.
# Do not set ANTHROPIC_API_KEY for this; the office does not use it.
CLAUDE_SONNET=claude-sonnet-5-5
CLAUDE_OPUS=claude-opus-5-5
CLAUDE_FALLBACK_MODEL=space-bunny-free
# CLAUDE_BACKEND=cli       # cli (default) = `claude -p`; oauth = raw OAuth call
# CLAUDE_BIN=              # path to the Claude Code binary (default: the npm global install)
# CLAUDE_CLI_TIMEOUT_SECONDS=300
# ASSISTANT_MODEL=claude-opus-5-5
# BUDGET_BRAIN_BIG_P=0.33
# BUDGET_BRAIN_BIG_LEAD=0.08
# BUDGET_BRAIN_LAYA_MS=3000
# BUDGET_BRAIN_CHEAP_MODEL=deepseek-v4.1-flash
# BUDGET_BRAIN_OPUS_SHARE=0.3

# ── Worker terminals ─────────────────────────────────────────────────────────
# Workers run in terminals of the `jcode` coding-agent CLI (must be on PATH, or set JCODE_BIN). Without it only MOCK_MODE works.
# JCODE_BIN=
# Machine-wide terminal limit (counted from real processes).
MAX_PARALLEL_SESSIONS=6
# The fleet will not open a new terminal while free memory is below this (MB). 0 = off.
MIN_FREE_RAM_MB=2048
RESUME_MIN_FREE_RAM_MB=2048
# FLEET_MAX_SESSIONS=6
# BUDGET_FLEET_MAX_PARALLEL_AMBER=10
# BUDGET_FLEET_MAX_PARALLEL_RED=3
# FLEET_MODEL_COMPLEX=kimi-k2.7-code
# FLEET_MODEL_STANDARD=deepseek-v4.1-flash
# FLEET_MODEL_ROUTINE=glm-5.3-flash
# LAYA_MODEL_CEILING=1
# LAYA_MODEL_MIN_CONF=0.4
# GATE_WAIT_SECONDS=600       # how long a pipeline waits at a gate before parking (resumable later)
# PIPELINE_MAX_LOOPS=1        # max manager review LOOP rounds before merging anyway

# ── Products (repos the office builds) ───────────────────────────────────────
# products.json lists them (copy products.example.json). docs/EXTENDING.md.
# PRODUCTS_FILE=products.json

# ── Integrations ─────────────────────────────────────────────────────────────
# Webhook for "order done / failed / needs approval": works with n8n, Slack, Discord, ntfy or any POST endpoint.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_FORMAT=json          # json | slack | discord | ntfy
# NOTIFY_EVENTS=done,failed,awaiting_approval
# NOTIFY_DRY_RUN=1            # log the payload, send nothing
# Slack two-way bridge (optional). Socket Mode (xapp-... + connections:write) is primary; without SLACK_APP_TOKEN it polls.
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# SLACK_APP_TOKEN=
# SLACK_BRIDGE=1              # 0 disables the bridge entirely
# SLACK_SOCKET_MODE=1
# SLACK_BRIDGE_INTERVAL_MS=4000
# Name shown for the human operator in the UI.
# CEO_NAME=Operator
# Company memory graph (optional; code is indexed offline, docs need an LLM key).
# GRAPHIFY_API_KEY=
# GRAPHIFY_BACKEND=openai
# MEMORY_AUTOREBUILD=1

# ── Event bus and routing extras ─────────────────────────────────────────────
# ADAPTIVE_ROUTING: 1 = a rule engine may adjust Laya's pick using live success rates, 0 = off.
ADAPTIVE_ROUTING=1
# Kafka broker for the event topic. Unset = an in-process topic (fine for one machine).
# KAFKA_BROKERS=127.0.0.1:9092
# AIR_GAPPED=1                # refuse every outbound provider call (docs/perf/AIR_GAPPED.md)
