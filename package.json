{
    "name":  "internal-llm-router",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc --noEmit",
                    "serve-laya":  "powershell -File scripts/serve-laya.ps1",
                    "setup":  "tsx ops/setup.ts",
                    "doctor":  "tsx ops/doctor.ts",
                    "scan:secrets":  "tsx ops/secret-scan.ts --staged",
