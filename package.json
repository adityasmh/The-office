                },
    "dependencies":  {
                         "dotenv":  "^16.4.5",
                         "express":  "^4.19.2",
                         "kafkajs":  "^2.2.4"
                     },
    "devDependencies":  {
                            "@types/express":  "^4.17.21",
                            "@types/node":  "^20.12.0",
                            "tsx":  "^4.7.0",
                            "typescript":  "^5.4.0"
                        }
}
